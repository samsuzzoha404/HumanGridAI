# Supabase Configuration
# Copy this file to .env.local and fill in your Supabase credentials
# The app will work with demo data if these are not configured

NEXT_PUBLIC_SUPABASE_URL=your_supabase_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Example:
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Note: If you don't configure Supabase, the app will automatically use
# demo data for development and testing purposes.
