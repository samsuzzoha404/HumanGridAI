# Server Configuration
HOST=0.0.0.0
PORT=8080
RUST_LOG=info,humangrid_service=debug

# Database (for caching only, not authoritative)
DATABASE_URL=postgresql://postgres:password@localhost:5432/humangrid

# Blockchain Configuration
CHAIN_ID=84532  # Base Sepolia
RPC_URL=https://sepolia.base.org
RPC_WS_URL=wss://sepolia.base.org

# Contract Addresses (from Phase 1 deployment)
ESCROW_CONTRACT_ADDRESS=
REPUTATION_CONTRACT_ADDRESS=

# Verifier Wallet (private key for signing transactions)
VERIFIER_PRIVATE_KEY=

# Security
API_KEY_SALT=change_this_in_production
MAX_REQUESTS_PER_MINUTE=100

# Task Configuration
CAPTCHA_TIMEOUT_SECONDS=300
MIN_CONFIDENCE_SCORE=0.75
MAX_RETRY_ATTEMPTS=3

# Reputation Thresholds
REPUTATION_BRONZE_TASKS=10
REPUTATION_SILVER_TASKS=50
REPUTATION_GOLD_TASKS=200
REPUTATION_PLATINUM_TASKS=1000

# External Services (optional)
SUPABASE_URL=
SUPABASE_KEY=

# Feature Flags
ENABLE_FRAUD_DETECTION=true
ENABLE_MULTI_HUMAN_CONSENSUS=false
ENABLE_REPUTATION_MINTING=true
